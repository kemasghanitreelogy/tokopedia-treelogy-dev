# ---- App credentials (Partner Center > Manage apps) ----
# Also set these on the Vercel project (Production) - the callback runs there.
APP_KEY=
APP_SECRET=

# ---- App identity (Partner Center app "Manage Order") ----
SERVICE_ID=7676046219668670224

# ---- Hosted OAuth callback ----
# The redirect_url registered in Partner Center must be exactly:
#   https://tokopedia-treelogy-dev.vercel.app/api/callback
# PUBLIC_BASE_URL=https://tokopedia-treelogy-dev.vercel.app

# ---- Blob store access ----
# Injected automatically on Vercel; locally it lives in .env.local
# (written by `vercel blob create-store` / `vercel env pull .env.local --yes`).
# BLOB_READ_WRITE_TOKEN=

# ---- Filled automatically by `npm run authorize` / `npm run pull` ----
ACCESS_TOKEN=
REFRESH_TOKEN=
ACCESS_TOKEN_EXPIRE_AT=
REFRESH_TOKEN_EXPIRE_AT=
OPEN_ID=
SELLER_NAME=
SHOP_ID=
SHOP_CIPHER=
SHOP_NAME=

# ---- Optional overrides ----
# API_BASE_URL=https://open-api.tiktokglobalshop.com
# AUTH_BASE_URL=https://auth.tiktok-shops.com

# ---- Shopee Open API v2 (app "Treelogy app", Seller In House System) ----
# Credentials from open.shopee.com/console/app > app detail. Each environment has its
# own pair and they are not interchangeable. LIVE_* is used whenever it is present.
LIVE_PARTNER_ID=
LIVE_API_PARTNER_KEY=
TEST_PARTNER_ID=
TEST_API_PARTNER_KEY=
# SHOPEE_ENV=test          # force the test pair / test host
# SHOPEE_HOST=             # override the host outright
# Live partner keys expire - the console shows the expiry date beside the app.

# The Callback URL registered on the Shopee app must be exactly:
#   https://tokopedia-treelogy-dev.vercel.app/api/shopee/callback

# ---- Filled automatically by the callback + `npm run shopee:pull` ----
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_ACCESS_TOKEN_EXPIRE_AT=
SHOPEE_SHOP_ID=
SHOPEE_SHOP_NAME=

# ---- Dashboard login ----
# Email + password are what a person types. DASHBOARD_TOKEN is a long random value used
# ONLY to sign session cookies (and as a bookmark key) - never sign sessions with the
# password, or a short one lets anyone mint a valid cookie.
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=
DASHBOARD_TOKEN=

# ---- Shopify Admin API ----
# The token is store-scoped but the Admin API is addressed per store, so the domain is
# required too. Any of these forms works: "namatoko", "namatoko.myshopify.com", or the
# full admin URL.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_API=
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
# SHOPIFY_API_VERSION=2026-07
