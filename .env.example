# ---- App credentials (Partner Center > Manage apps) ----
# Also set these on the Vercel project (Production) - the callback runs there.
APP_KEY=
APP_SECRET=

# ---- App identity ----
SERVICE_ID=7676046219668670224

# ---- Hosted OAuth callback ----
# The redirect_url registered in Partner Center must be exactly:
#   https://tokopedia-treelogy-dev.vercel.app/api/callback
# PUBLIC_BASE_URL=https://tokopedia-treelogy-dev.vercel.app

# ---- Blob store access ----
# Injected automatically on Vercel; locally it lives in .env.local
# (written by `vercel blob create-store` / `vercel env pull .env.local --yes`).
# BLOB_READ_WRITE_TOKEN=

# ---- Filled automatically by `npm run authorize` / `npm run pull` ----
ACCESS_TOKEN=
REFRESH_TOKEN=
ACCESS_TOKEN_EXPIRE_AT=
REFRESH_TOKEN_EXPIRE_AT=
OPEN_ID=
SELLER_NAME=
SHOP_ID=
SHOP_CIPHER=
SHOP_NAME=

# ---- Optional overrides ----
# API_BASE_URL=https://open-api.tiktokglobalshop.com
# AUTH_BASE_URL=https://auth.tiktok-shops.com
