# /etc/treelogy/env  — chmod 600, owner root:treelogy
# Salin nilai dari Vercel (`vercel env pull`) dan .env lokal. Tidak ada tanda kutip.
STATE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=treelogy:
PUBLIC_BASE_URL=https://api.treelogy-services.my.id

APP_KEY=
APP_SECRET=
SERVICE_ID=
LIVE_PARTNER_ID=
LIVE_API_PARTNER_KEY=
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_ADMIN_API=
STORE_NAME=
MEKARI_APP_CLIENT_ID=
MEKARI_APP_CLIENT_SECRET=
MEKARI_SYNC_LIVE=1
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=
DASHBOARD_TOKEN=
CRON_SECRET=
TELEGRAM_BOT=
TELEGRAM_CHAT_ID=
# Rahasia webhook GitHub untuk push-to-deploy; dibuat oleh skrip setup kalau kosong.
DEPLOY_SECRET=
DEPLOY_TRIGGER_PATH=/opt/treelogy/state/deploy-requested
DEPLOY_BRANCH=main
# Token TikTok awal (dari .env lokal); setelah itu hidup di state, bukan di sini.
ACCESS_TOKEN=
REFRESH_TOKEN=
ACCESS_TOKEN_EXPIRE_AT=
REFRESH_TOKEN_EXPIRE_AT=
SHOP_ID=
SHOP_CIPHER=
SHOP_NAME=
