# /etc/treelogy/env  — chmod 600, owner root:treelogy
# Salin nilai dari Vercel (`vercel env pull`) dan .env lokal. Tidak ada tanda kutip.
STATE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379
# Cache foto ulasan Tokopedia. Harus di bawah /opt/treelogy/state: layanan web berjalan
# dengan ProtectSystem=strict dan hanya boleh menulis ke sana, bukan ke folder aplikasi.
TOKOPEDIA_MEDIA_DIR=/opt/treelogy/state/tokopedia-media
REDIS_PREFIX=treelogy:
PUBLIC_BASE_URL=https://api.treelogy-services.my.id

APP_KEY=
APP_SECRET=
SERVICE_ID=
LIVE_PARTNER_ID=
LIVE_API_PARTNER_KEY=
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_ADMIN_API=
STORE_NAME=
MEKARI_APP_CLIENT_ID=
MEKARI_APP_CLIENT_SECRET=
MEKARI_SYNC_LIVE=1
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=
DASHBOARD_TOKEN=
CRON_SECRET=
TELEGRAM_BOT=
TELEGRAM_CHAT_ID=
# Rahasia webhook GitHub untuk push-to-deploy; dibuat oleh skrip setup kalau kosong.
DEPLOY_SECRET=
DEPLOY_TRIGGER_PATH=/opt/treelogy/state/deploy-requested
DEPLOY_BRANCH=main
# Token TikTok awal (dari .env lokal); setelah itu hidup di state, bukan di sini.
ACCESS_TOKEN=
REFRESH_TOKEN=
ACCESS_TOKEN_EXPIRE_AT=
REFRESH_TOKEN_EXPIRE_AT=
SHOP_ID=
SHOP_CIPHER=
SHOP_NAME=

# Email undangan pengguna (menu Pengguna). Gmail/Workspace: port 465, App Password 16 karakter.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Treelogy Omnichannel <kemas@treelogy.com>
# Nama yang tampil untuk akun pemilik (DASHBOARD_EMAIL) di log aktivitas dan memo Jurnal.
DASHBOARD_NAME=Kemas
