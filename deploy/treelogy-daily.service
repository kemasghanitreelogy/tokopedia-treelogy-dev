# /etc/systemd/system/treelogy-daily.service  (run by treelogy-daily.timer)
[Unit]
Description=Treelogy: riwayat penjualan, gambar produk, backup state
After=treelogy.service

[Service]
Type=oneshot
User=treelogy
Group=treelogy
WorkingDirectory=/opt/treelogy/app
EnvironmentFile=/etc/treelogy/env
Environment=NODE_ENV=production
# Baca ulang seluruh rentang sejak 1 Agustus, bukan hanya yang baru.
#
# Sapuan 15 menit hanya melihat tujuh hari terakhir, dan webhook hanya berbunyi untuk
# pesanan yang platformnya anggap berubah. Pesanan berumur tiga minggu yang statusnya
# bergerak tanpa push karena itu akan membeku di tahap lamanya - dulu tidak kelihatan
# karena dashboard selalu membaca platform, sekarang kelihatan karena tidak lagi. Satu
# pembacaan penuh per malam menutupnya, dan harganya sekitar satu menit.
ExecStart=-/usr/bin/node bin/tts.mjs db:backfill --yes
ExecStart=/usr/bin/node bin/tts.mjs history:pull
# Gambar dashboard ditarik sendiri, sebelum dan lepas dari urusan Jurnal. Dulu keduanya
# satu perintah, dan ketika kuota bulanan Jurnal habis perintah itu mati di permintaan
# pertamanya - dashboard lalu menampilkan "tanpa gambar" untuk semua produk karena alasan
# yang sama sekali tidak ada hubungannya dengan gambar.
ExecStart=-/usr/bin/node bin/tts.mjs images
ExecStart=-/usr/bin/node bin/tts.mjs mekari:images --yes
# Forecast last: it reads the history the pull just refreshed, and the stock the
# catalogues report. Failing here must not stop the backup below it.
ExecStart=-/usr/bin/node bin/tts.mjs forecast --notify
# Snapshot Redis to disk and keep a dated copy; 30 days retained. BGSAVE is asynchronous,
# so wait for it to finish before copying.
ExecStart=/bin/sh -c 'mkdir -p /opt/treelogy/backup && redis-cli BGSAVE >/dev/null && while [ "$(redis-cli INFO persistence | tr -d "\r" | grep rdb_bgsave_in_progress | cut -d: -f2)" = "1" ]; do sleep 1; done && cp /var/lib/redis/dump.rdb /opt/treelogy/backup/treelogy-$(date +%%F).rdb && find /opt/treelogy/backup -name "*.rdb" -mtime +30 -delete'
TimeoutStartSec=2h
