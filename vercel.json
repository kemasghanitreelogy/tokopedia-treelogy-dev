{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "outputDirectory": "public",
  "functions": {
    "api/labels.js": {
      "maxDuration": 180
    },
    "api/dashboard.js": {
      "maxDuration": 120
    },
    "api/export.js": {
      "maxDuration": 120
    },
    "api/mekari-sync.js": {
      "maxDuration": 120
    },
    "api/webhook/*.js": {
      "maxDuration": 60
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
